[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Firness
  FILE_GUID                      = e6476984-49ea-45f1-acf2-f488eaedba29
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
