[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Firness
  FILE_GUID                      = 0f14a883-02b8-43a5-b651-a97b48e3018f
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
