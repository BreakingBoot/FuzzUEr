[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Firness
  FILE_GUID                      = ee05a91d-2c61-4929-b8ca-b0c275620d74
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = FirnessMain

