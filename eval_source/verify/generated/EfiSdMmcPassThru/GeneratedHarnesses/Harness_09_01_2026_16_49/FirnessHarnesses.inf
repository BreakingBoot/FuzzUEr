[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = Firness
  FILE_GUID                      = 0433d986-bb51-4163-bf5a-e594cd00d07d
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = FirnessMain

#
